RELAY_DOMAIN=alphachannel.duckdns.org
ADMIN_TOKEN=change-me-to-a-random-secret
POSTGRES_USER=alphachannel
POSTGRES_PASSWORD=change-me-to-a-random-secret
POSTGRES_DB=alphachannel

# From registering AlphaChannel as its own OAuth app at https://xivauth.net/developer/docs (a
# separate registration from any other project's) - client_id/secret from that registration. The
# endpoint URLs below are confirmed against XIVAuth's "Authenticating to the API" docs and
# shouldn't need changing unless XIVAuth's API surface changes (it's explicitly marked WIP).
XIVAUTH_CLIENT_ID=
XIVAUTH_CLIENT_SECRET=
XIVAUTH_DEVICE_ENDPOINT=https://xivauth.net/oauth/authorize_device
XIVAUTH_TOKEN_ENDPOINT=https://xivauth.net/oauth/token
XIVAUTH_CHARACTERS_ENDPOINT=https://xivauth.net/api/v1/characters

# Optional - a Discord incoming webhook URL for the channel where the team reviews pending
# Lalafell social-access requests (see /admin/ui for the actual approve/deny action). Leave blank
# to skip Discord notifications entirely.
DISCORD_LALAFELL_WEBHOOK_URL=
